# Fetched build payload — assembled by scripts/fetch-deps.sh, never committed.
# lore alone is 33 MB and the JRE ~39 MB; both are reproducible from the script.
/src-tauri/binaries/*
!/src-tauri/binaries/.gitkeep
/src-tauri/resources/*
!/src-tauri/resources/.gitkeep

# Rust build output (8 GB and reproducible).
/src-tauri/target
/src-tauri/gen

# Working notes: plans, specs, scratch. Design that outlives them belongs in
