{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "alt-lore Desktop",
  "version": "0.1.0",
  "identifier": "com.alterante.lore.ui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "alt-lore Desktop",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/lore",
      "binaries/run-java"
    ],
    "resources": {
      "resources/alt-p2p-lore.jar": "alt-p2p-lore.jar",
      "resources/deps-manifest.json": "deps-manifest.json",
      "resources/jre/": "jre/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
